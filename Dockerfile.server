FROM node:20-alpine AS builder
WORKDIR /app

# 先复制依赖清单以便利用缓存
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/package.json
COPY apps/server/package.json apps/server/package.json

RUN npm ci

# 再复制源代码并构建
COPY packages/shared packages/shared
COPY apps/server apps/server

RUN npm run build --workspace @dnd/shared \
  && npm run build --workspace @dnd/server

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

# 复制完整 node_modules（包含 prisma cli，启动时要做 migrate deploy）
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/package-lock.json ./package-lock.json

COPY --from=builder /app/apps/server ./apps/server
COPY --from=builder /app/packages/shared ./packages/shared

# 只暴露 server 端口
EXPOSE 8787

CMD ["sh", "-lc", "node_modules/.bin/prisma migrate deploy --schema apps/server/prisma/schema.prisma && node apps/server/dist/index.js"]

